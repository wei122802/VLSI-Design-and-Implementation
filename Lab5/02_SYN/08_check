#!/bin/bash
#dcnxt_shell -f syn.tcl | tee syn.log
Design="AMED"

NO_COLOR='\033[0m'
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'

round() {
  printf "%.${2}f" "${1}"
}

# --- 1. 萃取純數值 ---
Cycle=$(cat Report/${Design}.timing | grep "clock clk (fall edge)" | grep -Eo '[+-]?[0-9]+([.][0-9]+)?' | sed -n '4p')
Area=$(cat Report/${Design}.area | grep 'Total cell area:' | grep -Eo '[+-]?[0-9]+([.][0-9]+)?')

# 先抓整行，再濾出第一個出現的浮點數，避開 mW, uW 等單位
Dynamic_raw=$(grep "Total Dynamic Power" Report/${Design}.power)
Leakage_raw=$(grep "Cell Leakage Power" Report/${Design}.power)
Dynamic=$(echo "$Dynamic_raw" | grep -Eo '[+-]?[0-9]+([.][0-9]+)?' | head -n 1)
Leakage=$(echo "$Leakage_raw" | grep -Eo '[+-]?[0-9]+([.][0-9]+)?' | head -n 1)

# --- 2. 萃取 Latency ---
# 假設此腳本在 02_SYN 執行，因此使用 ../01_RTL/vcs.log
latency_raw=$(grep "Your execution cycles =" ../01_RTL/vcs.log)
latency=$(echo "$latency_raw" | grep -Eo '[0-9]+' | head -n 1)

# 安全機制：若抓不到值，預設為 0 以防 bc 指令當機
if [ -z "$latency" ]; then latency=0; fi
if [ -z "$Dynamic" ]; then Dynamic=0; fi
if [ -z "$Leakage" ]; then Leakage=0; fi
if [ -z "$Area" ]; then Area=0; fi
if [ -z "$Cycle" ]; then Cycle=0; fi

gate_count=$(echo "$Area/9.9792" | bc -l)
flag=0

echo -e "${YELLOW}============================${NO_COLOR}"	
if grep -i -q 'Latch' 'syn.log'; then
	echo -e "${RED}--> X There is Latch in this design ---${NO_COLOR}"
    flag=1
else				
    echo -e "${GREEN}--> V Latch Checked!${NO_COLOR}"
fi

if grep -i -q 'mismatch' 'syn.log'; then
	echo -e "${RED}--> X Width Mismatch Error !! ---${NO_COLOR}"
    flag=1
else				
    echo -e "${GREEN}--> V Width Mismatch Checked!${NO_COLOR}"
fi

if grep -i -q 'Error' 'syn.log'; then
	echo  -e "${RED}--> X There is Error in this design !! ---${NO_COLOR}"
    flag=1
else				
    echo -e "${GREEN}--> V No Error in syn.log!${NO_COLOR}"
fi

if grep -i -q 'violated' "Report/${Design}.timing"; then
	echo  -e "${RED}--> X Timing (violated) ---${NO_COLOR}"
    flag=1
else				
    echo -e "${GREEN}--> V Timing (MET) Checked!${NO_COLOR}"
fi

echo -e "${YELLOW}============================${NO_COLOR}"
if [ $flag -eq 1 ] ; then
	echo -e "${RED}--> X 02_SYN Fail !! Please check out syn.log file.${NO_COLOR}"
else				
    echo -e "${GREEN}--> V 02_SYN Success !!${NO_COLOR}"  
fi

echo -e "${YELLOW}============================${NO_COLOR}"
echo -e "${YELLOW}Cycle: $Cycle ${NO_COLOR}"	

echo -e "${YELLOW}Gate count: $(round $gate_count 0) ${NO_COLOR}"
echo -e "${YELLOW}Dynamic: $Dynamic ${NO_COLOR}"
echo -e "${YELLOW}Leakage: $Leakage ${NO_COLOR}"
echo -e "${YELLOW}Latency: $latency ${NO_COLOR}"

# --- 3. 效能計算 ---
totalpower=$(echo "$Dynamic + $Leakage" | bc -l)

# 依據規格書: Performance = Power * Area * CYCLE_TIME * Latency

perf=$(echo "$Cycle * $Area * $latency" | bc -l)

echo -e "${YELLOW}Area: $Area ${NO_COLOR}"
echo -e "${YELLOW}Total Power: $(round $totalpower 4)u ${NO_COLOR}"
echo -e "${YELLOW}Performance Score: $(round $perf 2) ${NO_COLOR}"